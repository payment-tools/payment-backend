            <column name="ref" type="varchar(255)"/>

            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="enterpriseid" type="numeric(20)">
                <constraints nullable="false" foreignKeyName="fk_employeegroup_enterprise" references="enterprise(enterpriseid)"/>
            </column>

            <column name="status" type="varchar(50)">
                <constraints nullable="false"/>
            </column>

            <column name="creationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>
            <column name="modificationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>
        </createTable>

        <createTable tableName="employeegroupclient">
            <column name="employeegroupid" type="numeric(20)">
                <constraints nullable="false" foreignKeyName="fk_egc_employeegroup" references="employeegroup(employeegroupid)"/>
            </column>
            <column name="clientid" type="numeric(20)">
                <constraints nullable="false" foreignKeyName="fk_egc_client" references="client(clientid)"/>
            </column>
        </createTable>

        <createTable tableName="subvention">
            <column name="subventionid" type="numeric(20)">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="ref" type="varchar(255)"/>

