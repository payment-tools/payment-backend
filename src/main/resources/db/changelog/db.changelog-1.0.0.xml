<?xml version="1.1" encoding="UTF-8" standalone="no" ?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <changeSet id="1.0.0" author="mouhamed">

        <createTable tableName="jpa_sequence">
            <column name="seq_key" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column defaultValueComputed="NULL::numeric" name="seq_value" type="numeric(20)"/>
        </createTable>

        <createTable tableName="sales">
            <column name="salesid" type="numeric(20)">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="ref" type="varchar(255)"/>

            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="address" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="type" type="varchar(100)">
                <constraints nullable="false"/>
            </column>

            <column name="creationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>
            <column name="modificationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>
        </createTable>

        <createTable tableName="enterprise">
            <column name="enterpriseid" type="numeric(20)">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="ref" type="varchar(255)"/>

            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="address" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="maxquota" type="numeric(20)">
                <constraints nullable="false"/>
            </column>

            <column name="actualquota" type="numeric(20)"/>

            <column name="creationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>
            <column name="modificationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>

        </createTable>

        <createTable tableName="cashier">

            <column name="cashierid" type="numeric(20)">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="ref" type="varchar(255)"/>

            <column name="firstname" type="varchar(255)"/>

            <column name="lastname" type="varchar(255)"/>

            <column name="username" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="email" type="varchar(100)">
                <constraints unique="true"/>
            </column>

            <column name="phonenumber" type="varchar(100)">
                <constraints unique="true"/>
            </column>

            <column name="role" type="varchar(50)">
                <constraints nullable="false"/>
            </column>

            <column name="salesid" type="numeric(20)">
                <constraints nullable="false" foreignKeyName="fk_cashier_sales" references="sales(salesid)"/>
            </column>

            <column name="status" type="varchar(50)">
                <constraints nullable="false"/>
            </column>

                        <column name="creationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>

            <column name="modificationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>

        </createTable>


        <createTable tableName="client">
            <column name="clientid" type="numeric(20)">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="ref" type="varchar(255)"/>

            <column name="firstname" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="lastname" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="username" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="email" type="varchar(100)">
                <constraints unique="true" nullable="false"/>
            </column>

            <column name="phonenumber" type="varchar(100)">
                <constraints unique="true" nullable="false"/>
            </column>

            <column name="role" type="varchar(50)">
                <constraints nullable="false"/>
            </column>

            <column name="enterpriseid" type="numeric(20)">
                <constraints nullable="false" foreignKeyName="fk_client_enterprise" references="enterprise(enterpriseid)"/>
            </column>

            <column name="status" type="varchar(50)">
                <constraints nullable="false"/>
            </column>

                        <column name="creationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>

            <column name="modificationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>

        </createTable>

        <createTable tableName="enrolledmodules">
            <column name="enterpriseid" type="numeric(20)">
                <constraints nullable="false"/>
            </column>
            <column name="enrolledmodules" type="varchar(50)"/>
        </createTable>

        <createTable tableName="enterpriseconfiguration">
            <column name="enterpriseconfigurationid" type="numeric(20)">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="enterpriseid" type="numeric(20)">
                <constraints nullable="false" foreignKeyName="fk_enterpriseconfiguration_enterprise" references="enterprise(enterpriseid)"/>
            </column>

            <column name="maxamountrestauration" type="double"/>

            <column name="maxamountgasstation" type="double"/>

            <column name="maxamountmarket" type="double"/>

            <column name="maxamounttelephony" type="double"/>

            <column name="enterprisepercentage" type="numeric(20)">
                <constraints nullable="false"/>
            </column>

            <column name="employeepercentage" type="numeric(20)">
                <constraints nullable="false"/>
            </column>

                        <column name="creationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>

            <column name="modificationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>

        </createTable>

        <createTable tableName="enterpriseprofile">
            <column name="enterpriseprofileid" type="numeric(20)">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="enterpriseid" type="numeric(20)">
                <constraints nullable="false" foreignKeyName="fk_enterpriseprofile_enterprise" references="enterprise(enterpriseid)"/>
            </column>

            <column name="ref" type="varchar(255)"/>

            <column name="firstname" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="lastname" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="username" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="email" type="varchar(100)">
                <constraints unique="true" nullable="false"/>
            </column>

            <column name="phonenumber" type="varchar(100)">
                <constraints unique="true" nullable="false"/>
            </column>

            <column name="role" type="varchar(50)">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="varchar(50)">
                <constraints nullable="false"/>
            </column>

            <column name="creationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>
            <column name="modificationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>

        </createTable>

        <createTable tableName="partnership">
            <column name="partnershipid" type="numeric(20)">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="ref" type="varchar(255)"/>

            <column name="enterpriseid" type="numeric(20)">
                <constraints nullable="false" foreignKeyName="fk_partnership_enterprise" references="enterprise(enterpriseid)"/>
            </column>

            <column name="salesid" type="numeric(20)">
                <constraints nullable="false" foreignKeyName="fk_partnership_sales" references="sales(salesid)"/>
            </column>

            <column name="status" type="varchar(50)">
                <constraints nullable="false"/>
            </column>

                        <column name="creationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>

            <column name="modificationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>

        </createTable>

        <createTable tableName="payment">
            <column name="paymentid" type="numeric(20)">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="ref" type="varchar(255)"/>

            <column name="clientid" type="numeric(20)">
                <constraints nullable="false" foreignKeyName="fk_payment_client" references="client(clientid)"/>
            </column>

            <column name="cashierid" type="numeric(20)">
                <constraints nullable="false" foreignKeyName="fk_payment_cashier" references="cashier(cashierid)"/>
            </column>

            <column name="partnershipid" type="numeric(20)">
                <constraints nullable="false" foreignKeyName="fk_payment_partnership" references="partnership(partnershipid)"/>
            </column>

            <column name="amount" type="double">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="varchar(50)">
                <constraints nullable="false"/>
            </column>

            <column name="paymentdate" type="TIMESTAMP(6) WITHOUT TIMEZONE">
                <constraints nullable="false"/>
            </column>

                        <column name="creationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>

            <column name="modificationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>

        </createTable>

        <createTable tableName="salesconfigurations">
            <column name="salesconfigurationsid" type="numeric(20)">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="salesid" type="numeric(20)">
                <constraints nullable="false" foreignKeyName="fk_salesconfigurations_sales" references="sales(salesid)"/>
            </column>

            <column name="maxamount" type="double"/>

            <column name="minamount" type="double"/>

            <column name="creationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>
            <column name="modificationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>

        </createTable>

        <createTable tableName="salesprofile">
            <column name="salesprofileid" type="numeric(20)">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="ref" type="varchar(255)"/>

            <column name="firstname" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="lastname" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="username" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="email" type="varchar(100)">
                <constraints unique="true" nullable="false"/>
            </column>

            <column name="phonenumber" type="varchar(100)">
                <constraints unique="true" nullable="false"/>
            </column>

            <column name="role" type="varchar(50)">
                <constraints nullable="false"/>
            </column>

            <column name="salesid" type="numeric(20)">
                <constraints nullable="false" foreignKeyName="fk_salesprofile_sales" references="sales(salesid)"/>
            </column>

            <column name="status" type="varchar(50)">
                <constraints nullable="false"/>
            </column>

                        <column name="creationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>

            <column name="modificationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>
        </createTable>

        <createTable tableName="bills">

            <column name="billsid" type="numeric(20)">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="ref" type="varchar(255)"/>

            <column name="partnershipid" type="numeric(20)">
                <constraints nullable="false" foreignKeyName="fk_bills_partnership"
                             references="partnership(partnershipid)"/>
            </column>

            <column name="startdate" type="TIMESTAMP(6) WITHOUT TIMEZONE">
                <constraints nullable="false"/>
            </column>

            <column name="enddate" type="TIMESTAMP(6) WITHOUT TIMEZONE">
                <constraints nullable="false"/>
            </column>

            <column name="totalamount" type="double">
                <constraints nullable="false"/>
            </column>

            <column name="billstatus" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

                        <column name="creationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>
            <column name="modificationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>

        </createTable>
    </changeSet>

    <changeSet id="1.0.0-add-module-to-payment" author="mouhamed">
        <addColumn tableName="payment">
            <column name="module" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </addColumn>

    </changeSet>

    <changeSet id="1.0.0-drop-partnership-in-payment" author="mouhamed">
        <dropColumn tableName="payment" columnName="partnershipid"/>
    </changeSet>

    <changeSet id="1.0.0-add-employee-group-and-subvention" author="mouhamed">

        <createTable tableName="employeegroup">
            <column name="employeegroupid" type="numeric(20)">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="ref" type="varchar(255)"/>

            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="enterpriseid" type="numeric(20)">
                <constraints nullable="false" foreignKeyName="fk_employeegroup_enterprise" references="enterprise(enterpriseid)"/>
            </column>

            <column name="status" type="varchar(50)">
                <constraints nullable="false"/>
            </column>

            <column name="creationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>
            <column name="modificationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>
        </createTable>

        <createTable tableName="employeegroupclient">
            <column name="employeegroupid" type="numeric(20)">
                <constraints nullable="false" foreignKeyName="fk_egc_employeegroup" references="employeegroup(employeegroupid)"/>
            </column>
            <column name="clientid" type="numeric(20)">
                <constraints nullable="false" foreignKeyName="fk_egc_client" references="client(clientid)"/>
            </column>
        </createTable>

        <createTable tableName="subvention">
            <column name="subventionid" type="numeric(20)">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="ref" type="varchar(255)"/>

            <column name="employeepercent" type="double">
                <constraints nullable="false"/>
            </column>

            <column name="employerpercent" type="double">
                <constraints nullable="false"/>
            </column>

            <column name="partnershipid" type="numeric(20)">
                <constraints nullable="false" foreignKeyName="fk_subvention_partnership" references="partnership(partnershipid)"/>
            </column>

            <column name="employeegroupid" type="numeric(20)">
                <constraints nullable="false" foreignKeyName="fk_subvention_employeegroup" references="employeegroup(employeegroupid)"/>
            </column>

            <column name="status" type="varchar(50)">
                <constraints nullable="false"/>
            </column>

            <column name="creationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>
            <column name="modificationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>
        </createTable>

    </changeSet>

    <changeSet id="1.0.0-add-pk-employeegroupclient" author="mouhamed">
        <addPrimaryKey tableName="employeegroupclient" columnNames="employeegroupid,clientid" constraintName="pk_employeegroupclient"/>
    </changeSet>

    <changeSet id="1.0.0-init-jpa-sequence-employeegroup-subvention" author="mouhamed">
        <insert tableName="jpa_sequence">
            <column name="seq_key" value="EmployeeGroupId"/>
            <column name="seq_value" valueNumeric="1"/>
        </insert>
        <insert tableName="jpa_sequence">
            <column name="seq_key" value="SubventionId"/>
            <column name="seq_value" valueNumeric="1"/>
        </insert>
    </changeSet>

    <changeSet id="1.0.0-drop-insert" author="mouha">
        <sqlFile path="../data/insert-data.sql"
                 relativeToChangelogFile="true"
                 splitStatements="true"
                 stripComments="true"
                 encoding="UTF-8"/>
    </changeSet>

    <changeSet id="1.0.0-migrate-status-to-active" author="mouhamed">

        <addColumn tableName="client">
            <column name="active" type="BOOLEAN" defaultValueBoolean="false"/>
        </addColumn>
        <sql>UPDATE client SET active = (status = 'ACTIVE')</sql>
        <addNotNullConstraint tableName="client" columnName="active" columnDataType="BOOLEAN"/>
        <dropColumn tableName="client" columnName="status"/>

        <addColumn tableName="cashier">
            <column name="active" type="BOOLEAN" defaultValueBoolean="false"/>
        </addColumn>
        <sql>UPDATE cashier SET active = (status = 'ACTIVE')</sql>
        <addNotNullConstraint tableName="cashier" columnName="active" columnDataType="BOOLEAN"/>
        <dropColumn tableName="cashier" columnName="status"/>

        <addColumn tableName="enterpriseprofile">
            <column name="active" type="BOOLEAN" defaultValueBoolean="false"/>
        </addColumn>
        <sql>UPDATE enterpriseprofile SET active = (status = 'ACTIVE')</sql>
        <addNotNullConstraint tableName="enterpriseprofile" columnName="active" columnDataType="BOOLEAN"/>
        <dropColumn tableName="enterpriseprofile" columnName="status"/>

        <addColumn tableName="salesprofile">
            <column name="active" type="BOOLEAN" defaultValueBoolean="false"/>
        </addColumn>
        <sql>UPDATE salesprofile SET active = (status = 'ACTIVE')</sql>
        <addNotNullConstraint tableName="salesprofile" columnName="active" columnDataType="BOOLEAN"/>
        <dropColumn tableName="salesprofile" columnName="status"/>

        <addColumn tableName="partnership">
            <column name="active" type="BOOLEAN" defaultValueBoolean="false"/>
        </addColumn>
        <sql>UPDATE partnership SET active = (status = 'ACTIVE')</sql>
        <addNotNullConstraint tableName="partnership" columnName="active" columnDataType="BOOLEAN"/>
        <dropColumn tableName="partnership" columnName="status"/>

        <addColumn tableName="payment">
            <column name="active" type="BOOLEAN" defaultValueBoolean="false"/>
        </addColumn>
        <sql>UPDATE payment SET active = (status = 'ACTIVE')</sql>
        <addNotNullConstraint tableName="payment" columnName="active" columnDataType="BOOLEAN"/>
        <dropColumn tableName="payment" columnName="status"/>

        <addColumn tableName="employeegroup">
            <column name="active" type="BOOLEAN" defaultValueBoolean="false"/>
        </addColumn>
        <sql>UPDATE employeegroup SET active = (status = 'ACTIVE')</sql>
        <addNotNullConstraint tableName="employeegroup" columnName="active" columnDataType="BOOLEAN"/>
        <dropColumn tableName="employeegroup" columnName="status"/>

        <addColumn tableName="subvention">
            <column name="active" type="BOOLEAN" defaultValueBoolean="false"/>
        </addColumn>
        <sql>UPDATE subvention SET active = (status = 'ACTIVE')</sql>
        <addNotNullConstraint tableName="subvention" columnName="active" columnDataType="BOOLEAN"/>
        <dropColumn tableName="subvention" columnName="status"/>

    </changeSet>

    <changeSet id="1.0.0-add-qrcode-client" author="mouhamed">

        <createTable tableName="qrcodeclient">
            <column name="qrcodeclientid" type="numeric(20)">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="ref" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="clientid" type="numeric(20)">
                <constraints nullable="false" foreignKeyName="fk_qrcodeclient_client" references="client(clientid)"/>
            </column>

            <column name="used" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <column name="creationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>
            <column name="modificationdate" type="TIMESTAMP(6) WITHOUT TIMEZONE"/>
        </createTable>

        <insert tableName="jpa_sequence">
            <column name="seq_key" value="QRCodeClientId"/>
            <column name="seq_value" valueNumeric="1"/>
        </insert>

    </changeSet>
</databaseChangeLog>