    <!-- Téléphone obligatoire sur tous les comptes : cashier était le seul à l'accepter vide.
         Échoue tant qu'un caissier existant n'a pas de téléphone (données existantes non retouchées). -->
    <changeSet id="1.0.0-cashier-phonenumber-not-null" author="mouhamed">
        <addNotNullConstraint tableName="cashier" columnName="phonenumber" columnDataType="varchar(100)"/>
    </changeSet>

