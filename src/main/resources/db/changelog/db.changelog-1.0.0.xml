    <!-- Compteurs d'id (@TableGenerator) : une ligne par entité, au moins MAX(id) + 1.
         Lignes insérées hors API (jeu de démo, scripts) → sinon "duplicate key" aux premières créations. -->
    <changeSet id="1.0.0-sync-jpa-sequence" author="mouhamed">
        <sql splitStatements="true">
            INSERT INTO jpa_sequence (seq_key, seq_value) SELECT 'SalesId', COALESCE(MAX(salesid), 0) + 1 FROM sales
                ON CONFLICT (seq_key) DO UPDATE SET seq_value = GREATEST(jpa_sequence.seq_value, EXCLUDED.seq_value);
